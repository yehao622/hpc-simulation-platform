{
  "name": "hpc-simulation-api-gateway",
  "version": "1.2.0",
  "description": "API Gateway for HPC Simulation Platform with GraphQL support",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "build:force": "tsc --build --force",
    "graphql:schema": "cp src/graphql/schema.graphql dist/graphql/",
    "postbuild": "npm run graphql:schema"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.0.25",
    "apollo-server-express": "^3.13.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "graphql": "^16.11.0",
    "graphql-type-json": "^0.3.2",
    "helmet": "^6.0.1",
    "joi": "^17.7.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.8.0",
    "redis": "^4.6.4",
    "socket.io": "^4.8.1",
    "subscriptions-transport-ws": "^0.11.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/graphql": "^14.5.0",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/morgan": "^1.9.4",
    "@types/node": "^18.14.2",
    "@types/pg": "^8.6.6",
    "@types/socket.io": "^3.0.2",
    "@types/uuid": "^9.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
